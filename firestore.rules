rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Chỉ cho phép người dùng đã đăng nhập đọc/ghi dữ liệu thuộc về chính họ
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Thông báo liên server (Admin Broadcast Center - chỉ Admin được phát sóng/sửa/xóa)
    match /system_announcements/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'vithanlangthang333@gmail.com';
    }
  }
}
