rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cho phép người dùng đọc thông tin cơ bản của users (để Admin lấy danh sách thành viên)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Dữ liệu tiến độ con bên trong user (sessions, history...) chỉ chính user đó đọc/ghi
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Thông báo liên server (Admin Broadcast Center - mọi người đọc được, chỉ Admin được gửi/sửa/xóa)
    match /system_announcements/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.email == 'vithanlangthang333@gmail.com' ||
        request.auth.token.email == 'luongkutebs@gmail.com'
      );
    }
  }
}
